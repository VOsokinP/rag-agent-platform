# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://devagent:devagent@localhost:5433/devagent

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Models
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# Target repository to ingest. Change REPO_DIR too: a checkout of a different
# repository is refused rather than reused. The globs select which of its files
# are indexed; the defaults are FastAPI's layout. The sandbox runner image stays
# pinned to FastAPI - it bakes in that project's test dependencies.
REPO_URL=https://github.com/fastapi/fastapi
REPO_DIR=data/repos/fastapi
INCLUDE_CODE_GLOB=fastapi/**/*.py
INCLUDE_DOCS_GLOB=docs/en/docs/**/*.md
